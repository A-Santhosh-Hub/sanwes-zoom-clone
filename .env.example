LIVEKIT_API_KEY=sanwes
LIVEKIT_API_SECRET=<same secret as keys: in livekit.yaml>
# Must be reachable from the browser. Direct: ws://<lan-ip>:7880 . Behind Caddy (deploy/Caddyfile): wss://<host>/lk
LIVEKIT_URL=ws://localhost:7880
PORT=3000

# --- optional hardening ---
# Require a password for every room:
# JOIN_PASSWORD=change-me
# Per-room passwords (override JOIN_PASSWORD; an empty string makes that room open):
# ROOM_PASSWORDS={"standup":"hunter2","lobby":""}
# Join-token lifetime (connected users are refreshed automatically): 1h by default
# TOKEN_TTL=1h
# 'loopback' trusts X-Forwarded-For from Caddy on the same machine; use false if Node is directly exposed
# TRUST_PROXY=loopback
# TOKEN_RATE_MAX=20
# People allowed in one room (default 500; see docs/LARGE_MEETINGS.md). For a big event also raise TOKEN_RATE_MAX (per IP per minute).
# MAX_PARTICIPANTS=500
# New accounts allowed per hour from one address (default 10). Raise it for a big sign-up day, or while running the test suite.
# SIGNUP_RATE_MAX=10
# PASSWORD_FAIL_MAX=5
# Class tasks (see docs/CLASS_TASKS.md): where the class bot saves recordings (default: Videos\SanWe's Recordings), the biggest
# video you can upload (MB, default 4096), and which Edge/Chrome the class bot should use (found automatically if not set).
# RECORDINGS_DIR=D:\Recordings
# MEDIA_MAX_MB=4096
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Where accounts, meetings and the video library are kept (default: the data folder of this project).
# DATA_DIR=

# Hide the live room list on the join screen (default on, handy for demos):
# ROOM_LIST=off
# How the Node server reaches LiveKit's API (default http://127.0.0.1:7880):
# LIVEKIT_API_URL=http://127.0.0.1:7880

# The administrator's password list (Accounts > Password list): passwords people choose are kept in a separate encrypted file (data\vault).
# Set to off to stop recording them (people can then only be given a new password).
# KEEP_PASSWORDS=on
